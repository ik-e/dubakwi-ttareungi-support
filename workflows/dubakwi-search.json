      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "jsCode": "const b = $json.body || {}; const rid = typeof b.request_id === 'string' ? b.request_id : ''; const levels = b.access_levels; let error = null; if (!rid || typeof b.enabled !== 'boolean' || !Array.isArray(levels) || !levels.includes('public') || levels.some(x => !['public','restricted'].includes(x)) || new Set(levels).size !== levels.length || typeof b.query !== 'string' || (b.enabled && !b.query.trim()) || !b.deadline_at || !Number.isFinite(Date.parse(b.deadline_at))) error='invalid_request'; else if (Date.parse(b.deadline_at) <= Date.now()) error='deadline_exceeded'; return [{json:{request_id:rid, enabled:b.enabled === true, query:typeof b.query === 'string' ? b.query.trim() : '', levels, error, staff: Array.isArray(levels) && levels.includes('restricted')}}];"
      }
    },
    {
      "id": "a25b57cb-44e2-43cb-9311-7a9afc47dc25",
