      "parameters": {
        "jsCode": "const request = $('Validate request').first().json; const all = [...$('Search public').all(), ...$input.all()]; let error = all.some(x => x.json.error); let evidence = []; for (const x of all) { const j=x.json || {}; if (!j.document) continue; const m=j.document.metadata || {}; if (!request.levels.includes(m.access_level) || !['public','restricted'].includes(m.access_level)) { error=true; break; } if (!m.doc || !m.section || !m.chunk_id || !m.version || typeof j.score !== 'number' || typeof j.document.pageContent !== 'string' || !/^\\[(실제 안내|가상 설정)\\]/.test(j.document.pageContent)) { error=true; break; } if (j.score < 0.25) continue; const e={doc:m.doc,section:m.section,chunk_id:m.chunk_id,text:j.document.pageContent,score:j.score,access_level:m.access_level,version:m.version}; if(m.source_url) e.source_url=m.source_url; if(m.source_checked_at) e.source_checked_at=m.source_checked_at; evidence.push(e); } evidence.sort((a,b)=>b.score-a.score); evidence=evidence.slice(0,5); return [{json:{request_id:request.request_id,status:error?'error':evidence.length?'ok':'empty',evidence:error?[]:evidence,error_code:error?'search_failed':null}}];"
