# Public repository: default-deny root entries; local archives stay on disk.
/*
!/services/
!/services/**
!/.gitignore
!/.gitattributes
!/.python-version
!/pyproject.toml
!/uv.lock
!/README.md
!/AGENTS.md
!/.env.example

!/.github/
/.github/*
!/.github/workflows/
!/.github/pull_request_template.md

!/docs/
/docs/*
!/docs/README.md
!/docs/PUBLICATION.md
!/docs/PUBLIC-SOURCES.md
!/docs/PYTHON-DEVELOPMENT.md
!/docs/DEVELOPMENT-PLAN.md
!/docs/PRESENTATION-PLAN.md
!/docs/TEAM-START.md
!/docs/rag-knowledge/
!/docs/rag-knowledge/*.md
!/docs/project/
/docs/project/*
!/docs/project/README.md
!/docs/project/TOPIC.md
!/docs/project/TEAM-CHARTER.md
!/docs/project/SYSTEM-DESIGN.md
!/docs/project/WORKFLOW-DESIGN.md
!/docs/project/RAG-ARCHITECTURE.md
!/docs/project/STORAGE-DESIGN.md
!/docs/project/EXECUTION-RESULT.md
!/docs/project/TEAM-READINESS-REVIEW.md
!/docs/project/assets/
/docs/project/assets/*
!/docs/project/assets/workflow-flow.gif
!/docs/project/daily/
/docs/project/daily/*
!/docs/project/daily/*.md
!/docs/project/presentation/
/docs/project/presentation/*
!/docs/project/presentation/*.md

!/infra/
!/scripts/
/scripts/*
!/scripts/README.md
!/scripts/dev/
!/scripts/test/

# Future application code and reviewed mock/test inputs.
!/src/
!/tests/
!/workflows/
!/knowledge/
!/cases/
!/requests/
!/data/
/data/*
!/data/users.json
!/data/records.json

# Only reviewed, masked text summaries are shared; raw runs stay local.
!/runs/
/runs/*
!/runs/public/
/runs/public/**
!/runs/public/**/
!/runs/public/**/*.json
!/runs/public/**/*.md

# These exclusions override allowed development directories too.
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa
**/id_ed25519
**/*.dump
**/*.sql.gz
**/backups/
**/node_modules/
**/.venv/
**/.ruff_cache/
**/.pytest_cache/
**/.mypy_cache/
**/__pycache__/
**/*.pyc
**/*.egg-info/
**/build/
**/dist/
**/.local/
**/.n8n/
**/.DS_Store
**/Thumbs.db
