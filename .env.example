# Only confirmed local test-runner configuration is listed here.
# Copy to ignored .env and set the value privately when the VM credential is ready.
# This is the value sent as X-Team-Key, not an n8n credential ID.
DUBAKWI_WEBHOOK_TOKEN=
# run_cases.py reads environment variables; it does not load .env by itself.
# Use uv run --locked --env-file .env ... or inject the variable in the shell.
# This file is not a replacement for the existing VM n8n Compose/.env configuration.
