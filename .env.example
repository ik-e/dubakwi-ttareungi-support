# Local test-runner settings and PostgreSQL deployment-preparation names.
# Copy to ignored .env and set the value privately when the VM credential is ready.
# This is the value sent as X-Team-Key, not an n8n credential ID.
DUBAKWI_WEBHOOK_TOKEN=
# run_cases.py reads environment variables; it does not load .env by itself.
# Use uv run --locked --env-file .env ... or inject the variable in the shell.
# This file is not a replacement for the existing VM n8n Compose/.env configuration.
# Team fixture user API deployment. Keep real values outside Git.
DUBAKWI_N8N_NETWORK=
DUBAKWI_INTERNAL_KEY_FILE=


# PostgreSQL preparation only; not applied to the VM.
# Keep the real env file, password files and backups outside the repository.
# Set these only in the private --env-file for infra/postgres-compose.yaml.
# Empty required values cause Compose validation to stop.
DUBAKWI_POSTGRES_DATA_VOLUME=
DUBAKWI_POSTGRES_N8N_NETWORK=
DUBAKWI_POSTGRES_BOOTSTRAP_PASSWORD_FILE=
DUBAKWI_POSTGRES_OWNER_PASSWORD_FILE=
DUBAKWI_POSTGRES_RUNTIME_PASSWORD_FILE=
